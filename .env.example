# Root compose environment reference — see backend/.env.example and frontend/.env.example for service-level defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contract_review

# Required for the review step (Module 3) to actually call Claude.
# docker-compose.yml reads this from a root .env file via ${ANTHROPIC_API_KEY}.
ANTHROPIC_API_KEY=
