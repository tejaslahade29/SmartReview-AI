# Root compose environment reference — see backend/.env.example and frontend/.env.example for service-level defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contract_review

# Which provider the review step calls: "claude" or "gemini".
# docker-compose.yml reads these from a root .env file.
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
